# Server port
PORT=5000

# MongoDB connection string (MongoDB Atlas or local).
# If left empty, the app automatically falls back to an in-memory data store
# (great for local demos, the assessment, and tests) — see src/config/db.js
MONGO_URI=

# Allowed origin for CORS (your frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# How fast simulated order status progresses, in milliseconds
STATUS_STEP_MS=8000
